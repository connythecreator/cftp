# Maintainer: Conleth <103609099@student.swin.edu.au>
pkgname=cftp
pkgver=0.2.0
pkgrel=1
pkgdesc='QUIC-based file transfer with SSH-key authentication and optional mutual TLS'
arch=('x86_64')
url='https://github.com/connythecreator/cftp'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=(!lto)

build() {
  cd "$pkgname-$pkgver"
  cargo run --release --locked --example gen-assets -- packaging/generated
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --workspace --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/cftp "$pkgdir/usr/bin/cftp"
  install -Dm644 packaging/generated/cftp.1 "$pkgdir/usr/share/man/man1/cftp.1"
  install -Dm644 packaging/generated/cftp.bash "$pkgdir/usr/share/bash-completion/completions/cftp"
  install -Dm644 packaging/generated/_cftp "$pkgdir/usr/share/zsh/site-functions/_cftp"
  install -Dm644 packaging/generated/cftp.fish "$pkgdir/usr/share/fish/vendor_completions.d/cftp.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
